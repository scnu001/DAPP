# 部署后的 TicketNFT 合约地址（必填）
VITE_CONTRACT_ADDRESS=

# 可选：覆盖只读 RPC（游客浏览用）
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# relay Worker 的地址（活动封面上传用）。留空则上传功能不可用，其余功能正常。
# 部署步骤见 relay/README.md；形如 https://ticket-dapp-relay.<你的子域>.workers.dev
VITE_RELAY_URL=

# 兜底开关（默认 off）。on = 封面只存在本机浏览器，不上传、不上链。
# 详见 relay/README.md 与根 README 的「§1.8 链下 metadata 托管」。
VITE_LOCAL_COVER=off
