# ============================================================
#  团队约定：E2E 自动化脚本不入库
# ------------------------------------------------------------
#  e2e/ 下的脚本（wallet-login / mint-flow / mm-utils / debug-chainchange /
#  open-manual-demo）依赖：
#    1) 仓库外的 MetaMask 扩展目录（../verify-metamask/ext）
#    2) 系统 Edge 浏览器
#    3) 特定的 MetaMask 13.49 版本
#  别人 clone 下来跑不动，所以按约定不随仓库分发 —— 脚本保留在开发者本机。
#  注意：下面这行会同时排除根目录 e2e/ 和 wallet-login/e2e/（gitignore 的
#  “e2e/” 不带前导斜杠时匹配任意层级的同名目录）。
# ============================================================
e2e/

# ============================================================
#  私钥 / 环境变量
# ============================================================
# 根目录 .env 里有 DEPLOYER_PRIVATE_KEY / TEST_CLAIMER_PRIVATE_KEY，绝不入库
.env
.env.local
.env.*.local

# 但示例文件必须进库（同事据此创建自己的 .env）
!.env.example
!**/.env.example

# ============================================================
#  依赖与编译产物
# ============================================================
node_modules/
dist/
build/
artifacts/
cache/
coverage/
typechain-types/
.vite/
*.tsbuildinfo

# ============================================================
#  Hardhat 本地链部署产物（只对本地有意义；sepolia.json 要保留入库）
# ============================================================
deployments/hardhat.json
deployments/localhost.json

# ============================================================
#  浏览器 profile / 截图等 E2E 运行产物
#  ★ 每个 .edge-* profile 100~160MB，且内容是大段随机二进制，
#    一旦提交会把仓库彻底拖垮（实测 e2e/ 下累计 712MB）。
#    即使 e2e/ 已整体排除，这里仍保留一层兜底。
# ============================================================
.edge-*/
**/.edge-*/
shots-*/
**/shots-*/
.*-profile.txt
**/.*-profile.txt

# ============================================================
#  日志
# ============================================================
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
#  编辑器 / 操作系统
# ============================================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
